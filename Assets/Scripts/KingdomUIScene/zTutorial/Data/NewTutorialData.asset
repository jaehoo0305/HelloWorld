  - "S \uAFB9 \uB204\uB974\uBA74 \uAC74\uBB3C \uBC16\uC73C\uB85C \uB098\uAC08 \uC218
    \uC788\uC5B4"
  - "\uC6D0\uC815\uC73C\uB85C \uAC00\uC11C \uCD9C\uBC1C\uD558\uBA74 \uC804\uD22C
    \uD574\uBCFC \uC218 \uC788\uC5B4"
  - "\uD589\uC6B4\uC744 \uBE4C\uAC8C"
