  - facilityType: 2
    facilityName: "\uB9C8\uCF13"
    description: "\uBE44\uD2B8\uCF54\uC778\uC744 \uAE30\uBC18\uC73C\uB85C \uC5EC\uB7EC
      \uD22C\uC790 \uC885\uBAA9\uC744 \uC6B4\uC6A9\uD55C\uB2E4."
    initialUnlockType: 2
    levelUpDescriptions:
    - "\uC8FC\uC2DD \uD22C\uC790\uAC00 \uD574\uAE08\uB41C\uB2E4."
    - "\uC8FC\uC2DD \uD22C\uC790 \uC885\uBAA9\uC774 \uB298\uC5B4\uB09C\uB2E4."
    - "\uACF5\uB9E4\uB3C4\uAC00 \uD574\uAE08\uB41C\uB2E4."
    - "\uC635\uC158 \uD22C\uC790\uAC00 \uD574\uAE08\uB41C\uB2E4."
    - "\uC0AC\uCE58\uD488 \uAD6C\uB9E4\uAC00 \uD574\uAE08\uB41C\uB2E4."
    subFeatures: []
  - facilityType: 3
    facilityName: "\uD68C\uAD00"
    description: "\uC601\uC6C5\uC758 \uC0C1\uD0DC\uB97C \uC810\uAC80\uD558\uACE0,
      \uC11C\uC7AC\uB97C \uD1B5\uD574 \uBC29\uCE58 \uBAA8\uB4DC\uC5D0 \uC9C4\uC785\uD558\uAC70\uB098
      \uC6D0\uC815\uC744 \uB5A0\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    initialUnlockType: 0
    levelUpDescriptions:
    - "\uB2E4\uB978 \uBAA8\uB4E0 \uAC74\uBB3C\uC758 \uB808\uBCA8\uC5C5 \uC0C1\uD55C\uC774
      1\uB808\uBCA8\uC774 \uB41C\uB2E4."
    - "\uB2E4\uB978 \uBAA8\uB4E0 \uAC74\uBB3C\uC758 \uB808\uBCA8\uC5C5 \uC0C1\uD55C\uC774
      2\uB808\uBCA8\uC774 \uB41C\uB2E4."
    - "\uB2E4\uB978 \uBAA8\uB4E0 \uAC74\uBB3C\uC758 \uB808\uBCA8\uC5C5 \uC0C1\uD55C\uC774
      3\uB808\uBCA8\uC774 \uB41C\uB2E4."
    - "\uB2E4\uB978 \uBAA8\uB4E0 \uAC74\uBB3C\uC758 \uB808\uBCA8\uC5C5 \uC0C1\uD55C\uC774
      4\uB808\uBCA8\uC774 \uB41C\uB2E4."
    - "\uB2E4\uB978 \uBAA8\uB4E0 \uAC74\uBB3C\uC758 \uB808\uBCA8\uC5C5 \uC0C1\uD55C\uC774
