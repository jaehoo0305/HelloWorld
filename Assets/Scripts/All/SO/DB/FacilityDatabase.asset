  - facilityType: 4
    facilityName: "\uAD50\uD68C"
    description: "\uC2AC\uB86F\uC5D0 \uC601\uC6C5\uC744 \uBC30\uCE58\uD558\uACE0,
      \uC804\uB825\uC744 \uC18C\uBAA8\uD574 \uACFC\uC5F4\uC744 \uCE58\uB8CC\uD55C\uB2E4."
    initialUnlockType: 1
    levelUpDescriptions:
    - "\uC2AC\uB86F\uC774 \uD55C \uCE78 \uD574\uAE08\uB41C\uB2E4."
    - "\uACFC\uC5F4 \uB0C9\uAC01 \uC131\uB2A5\uC774 \uC99D\uAC00\uD55C\uB2E4."
    - "\uC2AC\uB86F\uC774 \uD55C \uCE78 \uD574\uAE08\uB41C\uB2E4."
    - "\uB0C9\uAC01 \uBE44\uC6A9\uC774 \uAC10\uC18C\uD55C\uB2E4."
    - "\uC2AC\uB86F\uC774 \uD55C \uCE78 \uD574\uAE08\uB41C\uB2E4."
