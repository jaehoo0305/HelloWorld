  - facilityType: 1
    facilityName: "\uC740\uD589"
    description: "\uC608\uAE08 \uBC0F \uB300\uCD9C\uC744 \uD558\uAC70\uB098 \uB2E4\uC591\uD55C
      \uBCF4\uD5D8\uC5D0 \uAC00\uC785\uD55C\uB2E4."
    initialUnlockType: 2
    levelUpDescriptions:
    - "\uB274\uC2A4\uAC00 \uD574\uAE08\uB41C\uB2E4."
    - "\uC608\uAE08\uC774 \uD574\uAE08\uB41C\uB2E4."
    - "\uBCF4\uD5D8\uC774 \uD574\uAE08\uB41C\uB2E4."
    - "\uB300\uCD9C\uC774 \uD574\uAE08\uB41C\uB2E4."
    - "\uAC24\uB7EC\uB9AC\uAC00 \uD574\uAE08\uB41C\uB2E4."
